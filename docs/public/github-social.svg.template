<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 640" role="img" aria-label="Yamete — lives in your menu bar, reacts when you touch it">

  <defs>
    <linearGradient id="bgGradient" x1="0" y1="0" x2="1280" y2="640" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#1a1a1a"/>
      <stop offset="0.5" stop-color="#141414"/>
      <stop offset="1"   stop-color="#0a0a0a"/>
    </linearGradient>

    <radialGradient id="logoGlow" cx="290" cy="320" r="300" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#ff6b8a" stop-opacity="0.28"/>
      <stop offset="1"   stop-color="#ff6b8a" stop-opacity="0"/>
    </radialGradient>

    <filter id="iconShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="14" stdDeviation="28" flood-color="#000000" flood-opacity="0.55"/>
    </filter>

    <g id="impactRays">
      <g stroke="#ff6b8a" stroke-linecap="round" stroke-width="6" opacity="0.6">
        <line x1="0" y1="-250" x2="0" y2="-205"/>
        <line x1="0" y1="250"  x2="0" y2="205"/>
        <line x1="-250" y1="0" x2="-205" y2="0"/>
        <line x1="250" y1="0"  x2="205" y2="0"/>
        <line x1="-177" y1="-177" x2="-145" y2="-145"/>
        <line x1="177"  y1="-177" x2="145"  y2="-145"/>
        <line x1="-177" y1="177"  x2="-145" y2="145"/>
        <line x1="177"  y1="177"  x2="145"  y2="145"/>
      </g>
      <g stroke="#ffb3c4" stroke-linecap="round" stroke-width="3" opacity="0.7">
        <line x1="-96" y1="-230" x2="-78" y2="-189"/>
        <line x1="96"  y1="-230" x2="78"  y2="-189"/>
        <line x1="-96" y1="230"  x2="-78" y2="189"/>
        <line x1="96"  y1="230"  x2="78"  y2="189"/>
        <line x1="-230" y1="-96" x2="-189" y2="-78"/>
        <line x1="230"  y1="-96" x2="189"  y2="-78"/>
        <line x1="-230" y1="96"  x2="-189" y2="78"/>
        <line x1="230"  y1="96"  x2="189"  y2="78"/>
      </g>
    </g>

    <style>
      .title {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 800;
        letter-spacing: -0.03em;
        fill: #ffb3c4;
      }
      .tagline {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 400;
        letter-spacing: 0.005em;
        fill: #f0f0f0;
      }
      .meta {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-weight: 500;
        fill: #ff6b8a;
      }
      .divider {
        stroke: #ff6b8a;
        stroke-opacity: 0.35;
        stroke-width: 1.5;
      }
    </style>
  </defs>

  <rect x="0" y="0" width="1280" height="640" fill="url(#bgGradient)"/>
  <ellipse cx="290" cy="320" rx="300" ry="300" fill="url(#logoGlow)"/>

  <g transform="translate(290, 320)">
    <use href="#impactRays"/>
    <image href="__ICON_DATA_URI__" x="-170" y="-170" width="340" height="340" filter="url(#iconShadow)" preserveAspectRatio="xMidYMid meet"/>
  </g>

  <line x1="580" y1="80" x2="580" y2="560" class="divider"/>

  <g transform="translate(620, 192)">
    <text class="title"   x="0" y="0"   font-size="130">Yamete</text>
    <text class="tagline" x="0" y="78"  font-size="34">Lives in your menu bar.</text>
    <text class="tagline" x="0" y="124" font-size="34">Reacts when you touch it.</text>

    <g transform="translate(0, 172)">
      <circle cx="14"  cy="14" r="14" fill="#ff6b8a"/>
      <circle cx="58"  cy="14" r="14" fill="#ffb3c4"/>
      <circle cx="102" cy="14" r="14" fill="#ff385f"/>
    </g>

    <text class="meta" x="0" y="262" font-size="24">Three sensors. Eleven triggers. Zero shame.</text>
  </g>
</svg>
