<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" role="img" aria-label="Yamete — a macOS app that reacts when you smack your laptop">

  <defs>
    <linearGradient id="bgGradient" x1="0" y1="0" x2="1200" y2="630" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#33101a"/>
      <stop offset="0.5" stop-color="#1f0810"/>
      <stop offset="1"   stop-color="#120509"/>
    </linearGradient>

    <radialGradient id="logoGlow" cx="270" cy="315" r="280" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#ff6b8a" stop-opacity="0.35"/>
      <stop offset="1"   stop-color="#ff6b8a" stop-opacity="0"/>
    </radialGradient>

    <linearGradient id="rightAccent" x1="500" y1="0" x2="1200" y2="630" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#9d1a3d" stop-opacity="0.07"/>
      <stop offset="1"   stop-color="#ff6b8a" stop-opacity="0.04"/>
    </linearGradient>

    <filter id="iconShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="26" flood-color="#000000" flood-opacity="0.55"/>
    </filter>

    <g id="impactRays">
      <g stroke="#ff6b8a" stroke-linecap="round" stroke-width="6" opacity="0.55">
        <line x1="0" y1="-230" x2="0" y2="-185"/>
        <line x1="0" y1="230"  x2="0" y2="185"/>
        <line x1="-230" y1="0" x2="-185" y2="0"/>
        <line x1="230" y1="0"  x2="185" y2="0"/>
        <line x1="-162" y1="-162" x2="-131" y2="-131"/>
        <line x1="162"  y1="-162" x2="131"  y2="-131"/>
        <line x1="-162" y1="162"  x2="-131" y2="131"/>
        <line x1="162"  y1="162"  x2="131"  y2="131"/>
      </g>
      <g stroke="#ffb3c4" stroke-linecap="round" stroke-width="3" opacity="0.7">
        <line x1="-88" y1="-213" x2="-71" y2="-173"/>
        <line x1="88"  y1="-213" x2="71"  y2="-173"/>
        <line x1="-88" y1="213"  x2="-71" y2="173"/>
        <line x1="88"  y1="213"  x2="71"  y2="173"/>
        <line x1="-213" y1="-88" x2="-173" y2="-71"/>
        <line x1="213"  y1="-88" x2="173"  y2="-71"/>
        <line x1="-213" y1="88"  x2="-173" y2="71"/>
        <line x1="213"  y1="88"  x2="173"  y2="71"/>
      </g>
    </g>

    <style>
      .title {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 800;
        letter-spacing: -0.03em;
        fill: #fff5f7;
      }
      .tagline {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 400;
        letter-spacing: 0.01em;
        fill: #ffc8d4;
        opacity: 0.92;
      }
      .meta {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-weight: 500;
        fill: #ff9bb3;
        opacity: 0.7;
      }
      .divider {
        stroke: #ff6b8a;
        stroke-opacity: 0.35;
        stroke-width: 1.5;
      }
    </style>
  </defs>

  <rect x="0" y="0" width="1200" height="630" fill="url(#bgGradient)"/>
  <rect x="0" y="0" width="1200" height="630" fill="url(#rightAccent)"/>
  <ellipse cx="270" cy="315" rx="280" ry="280" fill="url(#logoGlow)"/>

  <g transform="translate(270, 315)">
    <use href="#impactRays"/>
    <image href="__ICON_DATA_URI__" x="-150" y="-150" width="300" height="300" filter="url(#iconShadow)" preserveAspectRatio="xMidYMid meet"/>
  </g>

  <line x1="540" y1="80" x2="540" y2="550" class="divider"/>

  <g transform="translate(580, 180)">
    <text class="title" x="0" y="0" font-size="120">Yamete</text>
    <text class="tagline" x="0" y="68" font-size="30">a macOS menu bar app</text>
    <text class="tagline" x="0" y="108" font-size="30">that reacts when you smack it</text>

    <g transform="translate(0, 158)">
      <circle cx="14"  cy="14" r="14" fill="#ff6b8a"/>
      <circle cx="58"  cy="14" r="14" fill="#ffb3c4"/>
      <circle cx="102" cy="14" r="14" fill="#9ed8ff"/>
    </g>

    <text class="meta" x="0" y="240" font-size="22">accelerometer · microphone · AirPods IMU</text>
  </g>
</svg>
