<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" role="img" aria-label="Yamete — lives in your menu bar, reacts when you touch it">

  <defs>
    <!-- Docs palette: vp-c-bg 0a0a0a, vp-c-bg-alt 141414, vp-c-bg-elv 1a1a1a. Force-dark always. -->
    <linearGradient id="bgGradient" x1="0" y1="0" x2="1200" y2="630" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#1a1a1a"/>
      <stop offset="0.5" stop-color="#141414"/>
      <stop offset="1"   stop-color="#0a0a0a"/>
    </linearGradient>

    <radialGradient id="logoGlow" cx="270" cy="315" r="280" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#ff6b8a" stop-opacity="0.28"/>
      <stop offset="1"   stop-color="#ff6b8a" stop-opacity="0"/>
    </radialGradient>

    <filter id="iconShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="14" stdDeviation="28" flood-color="#000000" flood-opacity="0.55"/>
    </filter>

    <g id="impactRays">
      <g stroke="#ff6b8a" stroke-linecap="round" stroke-width="6" opacity="0.6">
        <line x1="0" y1="-240" x2="0" y2="-195"/>
        <line x1="0" y1="240"  x2="0" y2="195"/>
        <line x1="-240" y1="0" x2="-195" y2="0"/>
        <line x1="240" y1="0"  x2="195" y2="0"/>
        <line x1="-170" y1="-170" x2="-138" y2="-138"/>
        <line x1="170"  y1="-170" x2="138"  y2="-138"/>
        <line x1="-170" y1="170"  x2="-138" y2="138"/>
        <line x1="170"  y1="170"  x2="138"  y2="138"/>
      </g>
      <g stroke="#ffb3c4" stroke-linecap="round" stroke-width="3" opacity="0.7">
        <line x1="-92" y1="-220" x2="-74" y2="-180"/>
        <line x1="92"  y1="-220" x2="74"  y2="-180"/>
        <line x1="-92" y1="220"  x2="-74" y2="180"/>
        <line x1="92"  y1="220"  x2="74"  y2="180"/>
        <line x1="-220" y1="-92" x2="-180" y2="-74"/>
        <line x1="220"  y1="-92" x2="180"  y2="-74"/>
        <line x1="-220" y1="92"  x2="-180" y2="74"/>
        <line x1="220"  y1="92"  x2="180"  y2="74"/>
      </g>
    </g>

    <style>
      .title {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 800;
        letter-spacing: -0.03em;
        fill: #ffb3c4;
      }
      .tagline {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 400;
        letter-spacing: 0.005em;
        fill: #f0f0f0;
      }
      .meta {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-weight: 500;
        fill: #ff6b8a;
      }
      .divider {
        stroke: #ff6b8a;
        stroke-opacity: 0.35;
        stroke-width: 1.5;
      }
    </style>
  </defs>

  <rect x="0" y="0" width="1200" height="630" fill="url(#bgGradient)"/>
  <ellipse cx="270" cy="315" rx="280" ry="280" fill="url(#logoGlow)"/>

  <g transform="translate(270, 315)">
    <use href="#impactRays"/>
    <image href="__ICON_DATA_URI__" x="-160" y="-160" width="320" height="320" filter="url(#iconShadow)" preserveAspectRatio="xMidYMid meet"/>
  </g>

  <line x1="540" y1="80" x2="540" y2="550" class="divider"/>

  <g transform="translate(580, 178)">
    <text class="title" x="0" y="0" font-size="124">Yamete</text>
    <text class="tagline" x="0" y="72" font-size="32">Lives in your menu bar.</text>
    <text class="tagline" x="0" y="116" font-size="32">Reacts when you touch it.</text>

    <g transform="translate(0, 158)">
      <circle cx="14"  cy="14" r="14" fill="#ff6b8a"/>
      <circle cx="58"  cy="14" r="14" fill="#ffb3c4"/>
      <circle cx="102" cy="14" r="14" fill="#ff385f"/>
    </g>

    <text class="meta" x="0" y="240" font-size="22">Three sensors. Eleven triggers. Zero shame.</text>
  </g>
</svg>
