<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" role="img" aria-label="Yamete __VERSION__">

  <defs>
    <linearGradient id="bgGradient" x1="0" y1="0" x2="1200" y2="630" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#33101a"/>
      <stop offset="0.5" stop-color="#1f0810"/>
      <stop offset="1"   stop-color="#120509"/>
    </linearGradient>

    <radialGradient id="logoGlow" cx="270" cy="315" r="290" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#ff6b8a" stop-opacity="0.35"/>
      <stop offset="1"   stop-color="#ff6b8a" stop-opacity="0"/>
    </radialGradient>

    <linearGradient id="rightAccent" x1="500" y1="0" x2="1200" y2="630" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#9d1a3d" stop-opacity="0.07"/>
      <stop offset="1"   stop-color="#ff6b8a" stop-opacity="0.04"/>
    </linearGradient>

    <filter id="iconGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <g id="impactRays">
      <g stroke="#ff6b8a" stroke-linecap="round" stroke-width="6" opacity="0.55">
        <line x1="0" y1="-235" x2="0" y2="-190"/>
        <line x1="0" y1="235"  x2="0" y2="190"/>
        <line x1="-235" y1="0" x2="-190" y2="0"/>
        <line x1="235" y1="0"  x2="190" y2="0"/>
        <line x1="-166" y1="-166" x2="-134" y2="-134"/>
        <line x1="166"  y1="-166" x2="134"  y2="-134"/>
        <line x1="-166" y1="166"  x2="-134" y2="134"/>
        <line x1="166"  y1="166"  x2="134"  y2="134"/>
      </g>
      <g stroke="#ffb3c4" stroke-linecap="round" stroke-width="3" opacity="0.7">
        <line x1="-90" y1="-217" x2="-72" y2="-177"/>
        <line x1="90"  y1="-217" x2="72"  y2="-177"/>
        <line x1="-90" y1="217"  x2="-72" y2="177"/>
        <line x1="90"  y1="217"  x2="72"  y2="177"/>
        <line x1="-217" y1="-90" x2="-177" y2="-72"/>
        <line x1="217"  y1="-90" x2="177"  y2="-72"/>
        <line x1="-217" y1="90"  x2="-177" y2="72"/>
        <line x1="217"  y1="90"  x2="177"  y2="72"/>
      </g>
    </g>

    <style>
      .title {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 800;
        letter-spacing: -0.03em;
        fill: #fff5f7;
      }
      .tagline {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 400;
        letter-spacing: 0.01em;
        fill: #ffc8d4;
        opacity: 0.92;
      }
      .meta {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-weight: 500;
        fill: #ff9bb3;
        opacity: 0.75;
      }
      .version {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-weight: 700;
        fill: #fff5f7;
      }
      .versionPill {
        fill: #ff6b8a;
        fill-opacity: 0.22;
        stroke: #ff6b8a;
        stroke-opacity: 0.6;
        stroke-width: 1.5;
      }
      .divider {
        stroke: #ff6b8a;
        stroke-opacity: 0.35;
        stroke-width: 1.5;
      }
    </style>
  </defs>

  <rect x="0" y="0" width="1200" height="630" fill="url(#bgGradient)"/>
  <rect x="0" y="0" width="1200" height="630" fill="url(#rightAccent)"/>
  <ellipse cx="270" cy="315" rx="290" ry="290" fill="url(#logoGlow)"/>

  <g transform="translate(270, 315)">
    <use href="#impactRays"/>
    <image href="__ICON_DATA_URI__" x="-175" y="-175" width="350" height="350" filter="url(#iconGlow)" preserveAspectRatio="xMidYMid meet"/>
  </g>

  <line x1="540" y1="80" x2="540" y2="550" class="divider"/>

  <g transform="translate(580, 170)">
    <text class="title" x="0" y="0" font-size="120">Yamete</text>
    <text class="tagline" x="0" y="64" font-size="30">a macOS menu bar app</text>
    <text class="tagline" x="0" y="104" font-size="30">that reacts when you smack it</text>

    <g transform="translate(0, 152)">
      <rect class="versionPill" x="0" y="0" width="190" height="54" rx="27" ry="27"/>
      <text class="version" x="95" y="36" font-size="26" text-anchor="middle">__VERSION__</text>
    </g>

    <text class="meta" x="0" y="248" font-size="22">accelerometer · microphone · AirPods IMU</text>
  </g>
</svg>
